<?xml version="1.0" encoding="utf-8"?>
<!-- Scaffold de acessibilidade apenas em builds DEBUG (Fase 25). O APK de
     release NÃO declara o serviço nem a permissão, para não acionar a
     heurística do Google Play Protect em sideload. Em debug, o consentimento
     manual e a observabilidade continuam disponíveis. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <service
            android:name=".VegaAccessibilityService"
            android:exported="false"
            android:label="VEGA Device Control (scaffold)"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/vega_accessibility_config" />
        </service>
    </application>

</manifest>