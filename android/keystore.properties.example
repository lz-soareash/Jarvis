# Fase 22 — Signing da VEGA Mobile (NUNCA commitar valores reais).
# Copie para `keystore.properties` (o .gitignore/`android/.gitignore` o exclui) e
# gere seu keystore com:
#   keytool -genkeypair -v -keystore app/keystore/vega-release.jks \
#     -alias vega -keyalg RSA -keysize 2048 -validity 10000
#
# `storeFile` é relativo a android/app/. O keystore fica em android/app/keystore/
# (gitignored). Em CI, use as variáveis VEGA_KEYSTORE_BASE64 /
# VEGA_KEYSTORE_PASSWORD / VEGA_KEYSTORE_KEY_ALIAS / VEGA_KEYSTORE_KEY_PASSWORD
# (GitHub Secrets) — sem arquivo no repositório.
#
# Este é apenas um TEMPLATE: troque os valores abaixo pelos SEUS ANTES de usar.
storeFile=keystore/vega-release.jks
storePassword=TROCAR-ME
keyAlias=vega
keyPassword=TROCAR-ME