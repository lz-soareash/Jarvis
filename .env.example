# ===== JARVIS - variáveis de ambiente =====
# Copie este arquivo para `.env` e preencha os valores reais.
# NUNCA versione o arquivo `.env` (contém secrets). O `.gitignore` já o exclui.

# --- Ambiente ---
# development | production
ENV=development

# --- IA (Google Gemini) ---
# A chave fica EXCLUSIVAMENTE no backend. Nunca vai para o frontend/agente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Modelo de embeddings (memória semântica). Sem chave, a busca é lexical.
GEMINI_EMBED_MODEL=text-embedding-004

# --- AI Router (Fase 11 + extensão) ---
# Ordem de prioridade dos provedores de IA (primeiro = preferido). O Local LLM
# é o motor linguístico principal; Gemini é opcional; determinístico é o safety
# fallback local (sem API): horário, data, aritmética, saudação.
AI_PROVIDER_ORDER=local,gemini,deterministic
# Habilita/desabilita o fallback determinístico (safety). Se false, sem Gemini o
# chat retorna 503 (comportamento antigo).
AI_DETERMINISTIC_ENABLED=true

# --- Local LLM (Fase 11 extensão) — motor local generativo (llama.cpp) ---
# Habilitado apenas quando os arquivos GGUF existem (ver AI_LOCAL_LLM_MODEL_PATH).
AI_LOCAL_LLM_ENABLED=true
# Caminho (absoluto ou relativo ao repositório) do modelo de chat e do modelo de
# embedding. Vazios => resolução automática em .local_models/.
AI_LOCAL_LLM_MODEL_PATH=
AI_LOCAL_LLM_EMBED_PATH=
# Janela de contexto e threads (Ryzen 5 5600G: 6c/12t).
AI_LOCAL_LLM_N_CTX=2048
AI_LOCAL_LLM_N_THREADS=6
AI_LOCAL_LLM_TEMPERATURE=0.7

# --- Servidor (JARVIS Core) ---
# O Atlas já ocupa a porta 8000; o JARVIS usa 8100 (API) e 8101 (WebSocket futuro).
HOST=127.0.0.1
PORT=8100
WS_PORT=8101

# --- Persistência (Local-first: SQLite) ---
# Futuramente, para PostgreSQL, basta trocar a URL (ex.: postgresql+psycopg://...).
DATABASE_URL=sqlite:///./data/jarvis.db

# --- Chat ---
# Janela de mensagens recentes da sessão enviadas ao Gemini por resposta.
MAX_CONTEXT_MESSAGES=20

# --- Memória / Contexto (Fase 2) ---
# Memórias relevantes injetadas no prompt sistêmico por resposta.
MEMORY_CONTEXT_LIMIT=5
# A partir de quantas mensagens a sessão passa a ser resumida (resumo rolante).
SUMMARIZE_AFTER_MESSAGES=40
# Quantas mensagens são absorvidas pelo resumo a cada compactação.
SUMMARY_CHUNK=20

# --- Tool Engine (Fase 3) ---
# Rodadas máximas de chamadas de ferramenta por turno.
MAX_TOOL_ROUNDS=3

# --- Permissions (Fase 4) ---
# Validade, em segundos, de um pedido de aprovação pendente (padrão: 600 = 10 min).
APPROVAL_TTL_SECONDS=600

# --- Atlas (Fase 10) ---
# Camada externa de inteligência (projeto Django independente). Quando
# habilitado e configurado, o chat delega ao Atlas com fallback p/ Gemini local.
# ATLAS_BASE_URL é o host do servidor Atlas (API em {base}/api).
ATLAS_ENABLED=false
ATLAS_BASE_URL=http://127.0.0.1:8000
# Credenciais da conta do Atlas usadas para obter o JWT (nunca logadas).
ATLAS_EMAIL=
ATLAS_PASSWORD=
# Timeout (s) de conexão/leitura com o Atlas.
ATLAS_TIMEOUT=30
# Fase 14 — política de escrita de conhecimento no Atlas (AtlasWriteMode).
# Default conservador: "suggest" NUNCA escreve sem confirmação do usuário.
# Opções: disabled | suggest | auto | user_confirmed.
# ATLAS_WRITE_MODE=suggest

# --- Web Research (Fase 14) ---
# Camada de pesquisa local-first: busca real (DuckDuckGo, sem API key), coleta
# com proteção SSRF obrigatória (nunca rede interna), extração de conteúdo e
# síntese com citações (Router local → gemini → determinístico). Nenhum segredo
# é necessário para a coleta. Conteúdo web é tratado como dado NÃO-confiável.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
# Timeout (s) de uma consulta de busca e teto de resultados por consulta.
WEB_SEARCH_TIMEOUT=10
WEB_SEARCH_MAX_RESULTS=8
# Nova tentativa por consulta em falha recuperável do provider.
WEB_SEARCH_RETRIES=1
# Limites do Fetcher: timeout (s), teto de corpo (bytes), e máx. de redirects
# (cada hop é revalidado contra SSRF/DNS-rebinding).
WEB_FETCH_TIMEOUT=10
WEB_FETCH_MAX_BYTES=524288
WEB_FETCH_MAX_REDIRECTS=3
# Limites do Research Agent: consultas, páginas, bytes totais e duração (s).
WEB_RESEARCH_MAX_QUERIES=3
WEB_RESEARCH_MAX_PAGES=4
WEB_RESEARCH_MAX_TOTAL_BYTES=2097152
WEB_RESEARCH_MAX_DURATION=40
# Evidências independentes para considerar a pesquisa suficiente.
WEB_RESEARCH_MIN_EVIDENCE=2
# Teto de tokens da síntese e status das tools web (enabled/default).
WEB_RESEARCH_SYNTHESIS_TOKENS=400
# WEB_TOOLS_STATUS=enabled

# --- Remote / Gateway (Fase 12.1 — foundation) ---
# Transporte com a Gateway EXTERNA. O JARVIS é sempre o CLIENTE (WebSocket
# outbound); nenhuma porta de entrada é aberta no PC. DESABILITADO por padrão:
# com REMOTE_ENABLED=false (ou sem endpoint/device id) nenhum worker/conexão é
# criado. Fase em construção: emparelhamento, comandos executáveis e mobile
# chegam em fases futuras da 12.x — o transporte NUNCA executa tools.
REMOTE_ENABLED=false
REMOTE_GATEWAY_URL=wss://gateway.example.com:443/ws
REMOTE_DEVICE_ID=
# Segredo de autenticação do device junto à Gateway (nunca aparece em logs).
REMOTE_DEVICE_TOKEN=

# --- Remote / Identity, Credentials & Pairing (Fase 12.2) ---
# Identidade é SEMPRE derivada da credencial; device_id alegado pelo cliente
# nunca resolve identidade (discrepância => rejeição). Bootstrap local: o
# segredo inicial vem deste arquivo (REMOTE_DEVICE_ID + REMOTE_DEVICE_TOKEN);
# o banco guarda apenas hashes (sha256), nunca tokens/códigos em claro.
# Código de emparelhamento: 10 dígitos, TTL 10min, 5 tentativas, taxa global.
REMOTE_PAIRING_CODE_LENGTH=10
REMOTE_PAIRING_TTL_SECONDS=600
REMOTE_PAIRING_MAX_ATTEMPTS=5
REMOTE_PAIRING_MAX_ACTIVE=10
REMOTE_TOKEN_ENTROPY_BYTES=32
REMOTE_MAX_ACTIVE_CREDENTIALS=10
REMOTE_PAIRING_GATE_CAPACITY=5.0
REMOTE_PAIRING_GATE_REFILL=0.5

# --- Remote / Persistent Agent & Command Execution (Fase 12.3) ---
# Com REMOTE_ENABLED=true, o JARVIS mantém UMA conexão persistente com a
# Gateway (outbound) como agente: autentica, envia heartbeat, reconecta com
# backoff exponencial e processa comandos recebidos. Comandos NUNCA executam
# fora do pipeline local (Tool Registry + Permission Engine + AuditLog); níveis
# >= 2 exigem aprovação do usuário (Sessão JARVIS por device). A identidade
# sempre vem da credencial; REVOGADA é terminal (sem reconnect infinito).
# Offline: a Gateway é responsável pelo retry; o device não bufferiza — cada
# comando carrega um expires_at (TTL abaixo) e não tem replay.
REMOTE_COMMAND_TTL_SECONDS=3600
REMOTE_COMMAND_MAX_PAYLOAD=16384
REMOTE_RECONNECT_MIN_DELAY=0.5
REMOTE_RECONNECT_MAX_DELAY=60.0
REMOTE_RECONNECT_JITTER=0.1

# --- Remote / Access Layer — Fase 16 (endurecimento HTTP) ---
# Sessão remota: TTL de atividade (0 = sem expiração). A sessão é o RESULTADO
# da autenticação, nunca o segredo; expiração/revogação propagam ao SSE.
REMOTE_SESSION_TTL_SECONDS=3600
# Teto físico de um request HTTP para os endpoints /api/remote/* (413 antes de
# qualquer processamento). Payload maior que 20.000 caracteres também é negado.
REMOTE_MAX_PAYLOAD_BYTES=262144
# Rate limit de autenticação (anti brute-force): token bucket por IP + global.
REMOTE_AUTH_RATE_CAPACITY=10.0
REMOTE_AUTH_RATE_REFILL=0.5
# Rate limit de mensagens conversacionais POR DEVICE e teto de simultaneidade.
REMOTE_MESSAGE_RATE_CAPACITY=20.0
REMOTE_MESSAGE_RATE_REFILL=1.0
REMOTE_MAX_CONCURRENT_MESSAGES=4
# CORS restritivo: lista separada por vírgulas (vazio = sem CORS). "*" é
# sempre rejeitado. O middleware só entra quando REMOTE_ENABLED=true.
# REMOTE_CORS_ORIGINS=https://app.example.com,https://panel.example.com

# --- Proactive Agent (Fase 17) ---
# Iniciativa controlada: TUDO desligado por padrão. Habilite de forma explícita.
# Capacidade geral de proatividade (agendado, eventos, delivery).
PROACTIVE_ENABLED=false
# Scheduler persistente (one-shot/interval/cron-lite) em execução.
PROACTIVE_SCHEDULER_ENABLED=false
# Tetos de notificações proativas e cooldown mínimo por tipo de evento (s).
PROACTIVE_MAX_PER_HOUR=12
PROACTIVE_MAX_PER_DAY=48
PROACTIVE_DEFAULT_COOLDOWN_SECONDS=600
# Janela de silêncio "HH:MM-HH:MM" (pode cruzar meia-noite). Em quiet hours,
# LOW/NORMAL/HIGH são adiados; CRITICAL só interrompe se estiver explícito.
PROACTIVE_QUIET_HOURS=22:00-07:00
# Fuso local (minutos, UTC+; BRT = -180) usado para avaliar quiet hours.
PROACTIVE_TIMEZONE_OFFSET_MINUTES=-180
# "critical" NUNCA interrompe quiet hours por padrão. Não mude sem necessidade.
PROACTIVE_INTERRUPT_ON_CRITICAL=false
# Ciclo do worker proativo (s) — respeita o lifespan; evite valores < 10.
PROACTIVE_TICK_SECONDS=30

# --- Computer Action Layer (Fase 18) ---
# Ações controladas de mouse/teclado/janela (tool `computer_action`).
# DESLIGADO por padrão: ativar controle de mouse/teclado exige decisão explícita.
# dry_run funciona com a camada habilitada e NÃO executa física.
COMPUTER_ACTIONS_ENABLED=false
# Timeout (s) de execução física de UMA ação.
COMPUTER_ACTION_TIMEOUT_SECONDS=10
# Limites por tipo (validator).
COMPUTER_ACTION_MAX_TYPE_TEXT_CHARS=500
COMPUTER_ACTION_MAX_SCROLL_AMOUNT=10
COMPUTER_ACTION_MAX_HOTKEY_KEYS=3
# Rate limit global (token bucket).
COMPUTER_ACTION_RATE_CAPACITY=20
COMPUTER_ACTION_RATE_REFILL_PER_SECOND=2
COMPUTER_ACTION_MAX_ACTIONS_PER_MINUTE=60
# Combinações de teclas ADICIONAIS bloqueadas além das padrão
# (CTRL+ALT+DEL, CTRL+SHIFT+ESC, ALT+F4, CTRL+ALT+F2). Formato: "A+B+C" separadas
# por vírgula. Ex.: COMPUTER_ACTION_BLOCKED_HOTKEYS=CTRL+ALT+U,CTRL+ALT+F8
COMPUTER_ACTION_BLOCKED_HOTKEYS=

# --- Computer Agent / Computer Use Agent (Fase 19) ---
# Agente que planeja, verifica e executa passos de Computer Use sobre a camada
# de percepção + action. DESLIGADO por padrão: enquanto `enabled=false`, a API
# de tarefas retorna 503 e a tool `computer_use` não está disponível.
COMPUTER_AGENT_ENABLED=false
# Nível de autonomia (C0 observe-only ... C4 aprovado explicitamente). O agente
# NUNCA altera o próprio nível. C2+ pede confirmação conforme abaixo.
COMPUTER_AGENT_AUTONOMY=C1
# Limites rígidos do loop do agente (evita loops e rajadas).
COMPUTER_AGENT_MAX_STEPS=12
COMPUTER_AGENT_MAX_ACTIONS=24
COMPUTER_AGENT_MAX_RETRIES=2
COMPUTER_AGENT_TIMEOUT_SECONDS=180
# Exige confirmação (approval) para ações nível 2 durante o loop.
COMPUTER_AGENT_REQUIRE_CONFIRMATION_L2=true
# Teto de planos reprovados pela verificação antes de FAIL.
COMPUTER_AGENT_MAX_PLAN_RETRIES=3

# --- V1 — Integração & Estabilização (Fase 20) ---
# Fase de integração: a tool `computer_use` executa o loop do agente DENTRO do
# turno de chat e transmite os eventos reais via `agent_event` no SSE (card de
# tarefa ao vivo). Presença exibe estados fine-grained reais
# (perceiving/planning/executing/observing/verifying/recovering) quando o agente
# está ativo. Autonomia NUNCA vem dos argumentos da tool — só a config decide.
# Nenhuma variável nova obrigatória: as flags acima (COMPUTER_AGENT_ENABLED,
# COMPUTER_AGENT_AUTONOMY, limites) já controlam o comportamento V1.

# --- Identity / Personality (Fase 19) ---
# Identidade do assistente INDEPENDENTE do provider de IA. `ASSISTANT_NAME` é o
# nome de exibição (VEGA); o nome técnico do projeto/repositório permanece JARVIS.
# Personalidade NUNCA altera permissões/segurança (é camada própria do prompt).
ASSISTANT_NAME=VEGA
ASSISTANT_TONE=professional
ASSISTANT_VERBOSITY=adaptive
ASSISTANT_PROACTIVITY=controlled
ASSISTANT_HUMOR=subtle
ASSISTANT_FORMALITY=adaptive

# --- VEGA Presence (Fase 19.5) ---
# Presença derivada de SINAIS REAIS (offline/error/waiting_confirmation/working/
# thinking/idle) — nunca fingida. Só registra eventos de transição
# (`vega.state.changed`); é observabilidade, nunca altera permissões.
VEGA_PRESENCE_ENABLED=true
# ATENÇÃO: o Atlas é OPCIONAL — ATLAS_ENABLED=false (padrão) ou indisponível
# NUNCA atinge o chat da VEGA (fallback local garantido).

# --- Logging ---
LOG_LEVEL=INFO