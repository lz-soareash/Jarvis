# ===== JARVIS - variáveis de ambiente =====
# Copie este arquivo para `.env` e preencha os valores reais.
# NUNCA versione o arquivo `.env` (contém secrets). O `.gitignore` já o exclui.

# --- Ambiente ---
# development | production
ENV=development

# --- IA (Google Gemini) ---
# A chave fica EXCLUSIVAMENTE no backend. Nunca vai para o frontend/agente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Modelo de embeddings (memória semântica). Sem chave, a busca é lexical.
GEMINI_EMBED_MODEL=text-embedding-004

# --- Servidor (JARVIS Core) ---
# O Atlas já ocupa a porta 8000; o JARVIS usa 8100 (API) e 8101 (WebSocket futuro).
HOST=127.0.0.1
PORT=8100
WS_PORT=8101

# --- Persistência (Local-first: SQLite) ---
# Futuramente, para PostgreSQL, basta trocar a URL (ex.: postgresql+psycopg://...).
DATABASE_URL=sqlite:///./data/jarvis.db

# --- Chat ---
# Janela de mensagens recentes da sessão enviadas ao Gemini por resposta.
MAX_CONTEXT_MESSAGES=20

# --- Memória / Contexto (Fase 2) ---
# Memórias relevantes injetadas no prompt sistêmico por resposta.
MEMORY_CONTEXT_LIMIT=5
# A partir de quantas mensagens a sessão passa a ser resumida (resumo rolante).
SUMMARIZE_AFTER_MESSAGES=40
# Quantas mensagens são absorvidas pelo resumo a cada compactação.
SUMMARY_CHUNK=20

# --- Logging ---
LOG_LEVEL=INFO